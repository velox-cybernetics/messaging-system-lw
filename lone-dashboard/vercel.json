{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/html/overview.html" },
    { "source": "/messages", "destination": "/html/messages.html" },
    { "source": "/follow-ups", "destination": "/html/follow-ups.html" },
    { "source": "/system", "destination": "/html/system.html" },
    { "source": "/login", "destination": "/html/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
